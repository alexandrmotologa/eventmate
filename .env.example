# EventMate Environment Configuration

# Server Port
PORT=8080

# Telegram Bot Token (from @BotFather)
# Set to 'mock_token' if testing locally without Telegram
TELEGRAM_BOT_TOKEN=mock_token

# Demo Mode: automatically seeds "Friday Team Dinner" with 6 simulated participants
# and a 4-option ranked poll. Bypasses Telegram initData authentication for local testing.
DEMO_MODE=true

# Database storage path
DATABASE_PATH=./data/eventmate.db

# Public Web URL (required for Telegram Mini App button in live bots; localhost works for local demo)
APP_URL=http://localhost:8080
